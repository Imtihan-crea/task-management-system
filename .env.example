# Jangan commit file ini yang berisi secret!
# Copy file ini menjadi .env.local lalu isi nilainya.

# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_key_di_sini

# Hanya dipakai di server. JANGAN pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_di_sini

# URL aplikasi untuk link invitation. Wajib diisi di Vercel
# (Production DAN Preview). Tanpa slash di akhir.
APP_URL=http://localhost:3000

# Brevo API untuk email notifikasi aplikasi (task DONE, dst).
# Ambil dari Brevo Dashboard > SMTP & API. Bukan SMTP user/pass Supabase.
BREVO_API_KEY=isi_brevo_api_key_di_sini
# Harus email pengirim yang sudah diverifikasi di Brevo.
BREVO_SENDER_EMAIL=no-reply@contoh.com
BREVO_SENDER_NAME=Task Management System
