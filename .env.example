# Jangan commit file ini yang berisi secret!
# Copy file ini menjadi .env.local lalu isi nilainya.
# Ambil nilainya dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_key_di_sini
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_di_sini_hanya_server_jangan_ke_frontend

# URL aplikasi untuk link undangan (tanpa slash di akhir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
